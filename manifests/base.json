{
  "manifest_version": 3,
  "name": "Chat by Default",
  "version": "1.0.2",
  "description": "Opens chatgpt.com in Chat instead of Work.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
